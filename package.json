{
  "name": "nrc-model-viewer",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"electron . --dev\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.169.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.0",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.7",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.nrc.model-viewer",
    "productName": "NRC Model Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-v${version}-portable.exe"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "nrc-model-viewer"
    }
  }
}
